# Postgres (Coolify standalone; set in Coolify secrets — do not commit real values)
DATABASE_URL=

# Engine alerts (optional) — Telegram NOT recommended (Eric: Web Push only)
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Web -> engine (docker-compose sets this automatically)
ENGINE_URL=http://engine:8000

# --- Signal feature flags (ALL off by default; set true only after explicit OK) ---
# Coolify (trader UUID onx2blngujkokmltpugysuh4): set as runtime env, redeploy one service.
# Confluence/MTF ON without OOS → shadow/log only (does not block trades).
SIGNAL_CONFLUENCE_ENABLED=false
SIGNAL_MTF_ENABLED=false
# Kelly: eval-only until sample≥200 AND OOS OK; never raises risk above 2%/trade.
SIGNAL_KELLY_ENABLED=false
SIGNAL_ONCHAIN_ENABLED=false
SIGNAL_SUPER_OPP_ENABLED=false
SIGNAL_PASSIVE_WAKE_ENABLED=false
SIGNAL_POST_TRADE_AI_ENABLED=false
WEB_PUSH_ENABLED=false

# --- Web Push / PWA (point 19) — public key may be exposed; NEVER commit private key ---
# Requires HTTPS on a public domain (Samsung / mobile PWA). No Telegram.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# --- Passiveive wake (point 20) — Coolify env docs only ---
# PASSIVE_WAKE_THRESHOLD_PCT=0.015
# Engine polls market deterministically; wakes AI only above threshold when enabled.

# --- Paper order book depth (lot 8) — optional; hypothesis-labeled simulation ---
# ORDER_BOOK_DEPTH_ENABLED=false
# ORDER_BOOK_DEPTH_LEVELS=5

# --- Execution twin (shadow L2) — default ON in BotParams; align fee_tier to your Coinbase account ---
# EXECUTION_TWIN_ENABLED=true
# FEE_TIER=us_intro
# # us_intro → taker 90 / maker 50 bps · eu_intro → 50 / 25 · custom → set TAKER_FEE_BPS / MAKER_FEE_BPS
# # Gate go-live: GET /fidelity (needs ~14d + 100 twin fills). Never places real orders.

# --- Live LLM co-pilot (paper) — preferred: dashboard /llm/params (app wins over env) ---
# Env below is optional fallback when an in-app field is empty.
# Coolify trader UUID onx2blngujkokmltpugysuh4: optional keys; enable via UI or COPILOT_ENABLED.
# COPILOT_ENABLED=false
# LLM_FREE_POOL=auto
# GROQ_API_KEY=
# GROQ_API_KEY_2=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.1-flash-lite
# OPENROUTER_FREE_MODEL=deepseek/deepseek-chat-v3-0324:free
# LLM_TIMEOUT_MS=2500
